      "source": [
        "import io\n",
        "import pydicom\n",
        "\n",
        "# Keep only real Mass-Training DICOM files\n",
        "mass_dcm_files = [\n",
        "    p for p in dicom_files\n",
        "    if p.lower().endswith(\".dcm\")\n",
        "    and (\"Mass-Training_\" in p or \"Mass-Test_\" in p)\n",
        "]\n",
        "print(f\"Mass DICOM files: {len(mass_dcm_files)}\")\n",
        "\n",
        "dcm_lookup = {}\n",
        "\n",
        "for i, path in enumerate(mass_dcm_files):\n",
        "\n",
        "    if i % 200 == 0:\n",
        "        print(f\"Processing {i}/{len(mass_dcm_files)}\")\n",
        "\n",
        "    try:\n",
        "        parts = path.split(\"/\")\n",
        "        idx = parts.index(\"cbis_ddsm\")\n",
        "        case_folder = parts[idx + 1]\n",
        "    \n",
        "        # Remove trailing \"_1\" if present\n",
        "        if case_folder.endswith(\"_1\"):\n",
        "         case_folder = case_folder[:-2]\n",
        "\n",
        "        with fs.open(path, \"rb\") as f:\n",
        "          ds = pydicom.dcmread(f, stop_before_pixels=True)\n",
        "        area = ds.Rows * ds.Columns\n",
        "\n",
        "        if (\n",
        "            case_folder not in dcm_lookup\n",
        "            or area > dcm_lookup[case_folder][0]\n",
        "        ):\n",
        "            dcm_lookup[case_folder] = (area, path)\n",
        "\n",
        "    except Exception as e:\n",
        "        print(f\"Skipping: {path}\")\n",
        "        continue\n",
        "print(f\"\\nMass lookup contains {len(dcm_lookup)} cases.\")"
      ]
    },
